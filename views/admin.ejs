<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin Dashboard</title>

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
</head>

<body class="bg-light">

  <!-- Navbar -->
  <nav class="navbar navbar-dark bg-dark">
    <div class="container">
      <a class="navbar-brand fw-bold" href="/">
        Lead Capture Admin
      </a>
      <form action="/admin" method="GET" class="d-flex">

        <div class="input-group" style="width: 320px;">



          <input type="text" class="form-control" name="search" placeholder="Search by name or email"
            value="<%= search || '' %>">

          <button class="btn btn-light" type="submit">
            <i class="bi bi-search"></i>
          </button>

        </div>

      </form>

      <a href="/logout" class="btn btn-danger ms-3">
        Logout
      </a>
    </div>
  </nav>

  <div class="container mt-5">

    <div class="d-flex justify-content-between align-items-center mb-4">
      <h2>All Leads</h2>

      <span class="badge bg-primary fs-6">
        Total Leads : <%= leads.length %>
      </span>
    </div>

    <div class="card shadow">

      <div class="card-body">

        <div class="table-responsive">

          <table class="table table-bordered table-hover align-middle">

            <thead class="table-dark">

              <tr>
                <th></th>
                <th>Name</th>
                <th>Email</th>
                <th>Budget</th>
                <th>Message</th>
                <th>Status</th>
                <th>Created</th>
                <th>Action</th>
              </tr>

            </thead>

            <tbody>

              <% if(leads.length===0){ %>

                <tr>
                  <td colspan="7" class="text-center text-muted">
                    No Leads Found
                  </td>
                </tr>

                <% } %>

                  <% leads.forEach((lead,index)=>{ %>

                    <tr>

                      <td>
                        <%= index+1 %>
                      </td>

                      <td>
                        <strong>
                          <%= lead.name %>
                        </strong>
                      </td>

                      <td>
                        <%= lead.email %>
                      </td>

                      <td>
                        <span class="badge bg-info text-dark">
                          <%= lead.budget %>
                        </span>
                      </td>

                      <td>
                        <%= lead.message %>
                      </td>

                      <td>
                        <div class="d-flex gap-1">

                          <!-- New -->
                          <form action="/admin/<%= lead._id %>/status?_method=PUT" method="POST">
                            <input type="hidden" name="status" value="New">

                            <button class="btn btn-sm <%= lead.status === 'New'
                    ? 'btn-primary'
                    : 'btn-outline-primary' %>">

                              New
                            </button>
                          </form>

                          <!-- Contacted -->
                          <form action="/admin/<%= lead._id %>/status?_method=PUT" method="POST">
                            <input type="hidden" name="status" value="Contacted">

                            <button class="btn btn-sm <%= lead.status === 'Contacted'
                    ? 'btn-warning'
                    : 'btn-outline-warning' %>">

                              Contacted
                            </button>
                          </form>

                          <!-- Closed -->
                          <form action="/admin/<%= lead._id %>/status?_method=PUT" method="POST">
                            <input type="hidden" name="status" value="Closed">

                            <button class="btn btn-sm <%= lead.status === 'Closed'
                    ? 'btn-success'
                    : 'btn-outline-success' %>">

                              Closed
                            </button>
                          </form>

                        </div>
                      </td>

                      <td>
                        <%= lead.createdAt.toLocaleDateString() %>
                      </td>
                      <td>
                        <form action="/admin/<%= lead._id %>?_method=DELETE" method="POST">

                          <button class="btn btn-sm btn-danger"
                            onclick="return confirm('Are you sure you want to delete this lead?')">

                            Delete

                          </button>

                        </form>
                      </td>


                    </tr>

                    <% }) %>

            </tbody>

          </table>

        </div>

      </div>

    </div>

  </div>

</body>

</html>