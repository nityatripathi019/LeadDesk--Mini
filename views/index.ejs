<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>LeadDesk</title>

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

  <style>
    html {
      scroll-behavior: smooth;
    }

    .hero {
      background: linear-gradient(135deg, #0d6efd, #4f8dfd);
      color: white;
      padding: 100px 0;
    }

    .feature-card {
      transition: 0.3s;
    }

    .feature-card:hover {
      transform: translateY(-8px);
    }

    .form-card {
      border-radius: 15px;
    }

    footer {
      margin-top: 80px;
    }
  </style>
</head>

<body class="bg-light">

  <!-- Navbar -->
  <nav class="navbar navbar-expand-lg navbar-dark bg-dark sticky-top">

    <% if(success){ %>

      <div class="container mt-4">

        <div class="alert alert-success alert-dismissible fade show" role="alert">

          <%= success %>

            <button type="button" class="btn-close" data-bs-dismiss="alert">
            </button>

        </div>

      </div>

      <% } %>

        <div class="container">

          <a class="navbar-brand fw-bold" href="#">
            LeadDesk
          </a>

          <button class="navbar-toggler" data-bs-toggle="collapse" data-bs-target="#nav">
            <span class="navbar-toggler-icon"></span>
          </button>

          <div class="collapse navbar-collapse" id="nav">

            <ul class="navbar-nav ms-auto">

              <li class="nav-item">
                <a class="nav-link" href="#">Home</a>
              </li>

              <li class="nav-item">
                <a class="nav-link" href="#services">Services</a>
              </li>

              <li class="nav-item">
                <a class="nav-link" href="#leadForm">Get Quote</a>
              </li>
              <li class="nav-item">
                <a class="nav-link" href="/login">Admin Login</a>


            </ul>

          </div>

        </div>

  </nav>

  <!-- Hero -->
  <section class="hero">

    <div class="container text-center">

      <h1 class="display-4 fw-bold">
        Build Your Dream Website
      </h1>

      <p class="lead mt-3">
        We build responsive, modern and professional websites
        for startups, businesses and personal brands.
      </p>

      <a href="#leadForm" class="btn btn-light btn-lg mt-3 px-4">
        Get a Free Quote
      </a>

    </div>

  </section>

  <!-- Services -->
  <section class="container my-5" id="services">

    <div class="text-center mb-5">

      <h2 class="fw-bold">
        Why Choose Us?
      </h2>

      <p class="text-muted">
        We provide complete web solutions for your business.
      </p>

    </div>

    <div class="row g-4">

      <div class="col-md-4">

        <div class="card feature-card shadow border-0 h-100">

          <div class="card-body text-center">

            <h1>🚀</h1>

            <h4>Fast Delivery</h4>

            <p class="text-muted">
              We deliver projects on time without compromising quality.
            </p>

          </div>

        </div>

      </div>

      <div class="col-md-4">

        <div class="card feature-card shadow border-0 h-100">

          <div class="card-body text-center">

            <h1>💻</h1>

            <h4>Responsive Design</h4>

            <p class="text-muted">
              Beautiful websites that work perfectly on every device.
            </p>

          </div>

        </div>

      </div>

      <div class="col-md-4">

        <div class="card feature-card shadow border-0 h-100">

          <div class="card-body text-center">

            <h1>💰</h1>

            <h4>Affordable Pricing</h4>

            <p class="text-muted">
              Flexible pricing suitable for startups and growing businesses.
            </p>

          </div>

        </div>

      </div>

    </div>

  </section>

  <!-- Lead Form -->
  <section class="container mb-5" id="leadForm">

    <div class="row justify-content-center">

      <div class="col-lg-7">

        <div class="card shadow-lg border-0 form-card">

          <div class="card-body p-5">

            <h2 class="text-center fw-bold">
              Request a Free Quote
            </h2>

            <p class="text-center text-muted mb-4">
              Fill out the form below and we'll contact you within 24 hours.
            </p>

            <form action="/lead" method="POST">

              <div class="mb-3">

                <label class="form-label">Full Name</label>

                <input type="text" class="form-control" name="name" placeholder="Enter your full name" required>

              </div>

              <div class="mb-3">

                <label class="form-label">Email Address</label>

                <input type="email" class="form-control" name="email" placeholder="Enter your email" required>

              </div>

              <div class="mb-3">

                <label class="form-label">Budget Range</label>

                <select class="form-select" name="budget" required>

                  <option value="">Choose Budget</option>
                  <option value="0-10k">₹0 - ₹10,000</option>
                  <option value="10k-50k">₹10,000 - ₹50,000</option>
                  <option value="50k-100k">₹50,000 - ₹1,00,000</option>
                  <option value="100k+">Above ₹1,00,000</option>

                </select>

              </div>

              <div class="mb-4">

                <label class="form-label">Project Details</label>

                <textarea class="form-control" rows="4" name="message" placeholder="Tell us about your project..."
                  required></textarea>

              </div>

              <button class="btn btn-primary w-100 py-2">
                Submit Request
              </button>

            </form>

          </div>

        </div>

      </div>

    </div>

  </section>

  <!-- Footer -->
  <footer class="bg-dark text-white text-center py-4">

    <div class="container">

      <h5 class="mb-2">LeadDesk</h5>

      <p class="mb-0">
        Helping businesses build their online presence.
      </p>

      <small class="text-secondary">
        © 2026 LeadDesk. All Rights Reserved.
      </small>

    </div>

  </footer>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

</body>

</html>